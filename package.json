{
  "name": "it-engineer-communication-book",
  "version": "1.0.0",
  "description": "システム思考とデータ駆動で身につける対人スキルとメンタル管理",
  "main": "index.md",
  "scripts": {
    "start": "cd docs && bundle exec jekyll serve --livereload",
    "build": "npm run check:content-drift && cd docs && bundle exec jekyll build && cd .. && npm run check:content-drift && npm run check:metadata:built && npm run check:accessibility:built",
    "test": "npm run test:content-sync && npm run test:accessibility && npm run test:external-links && npm run check:content-drift && npm run check:accessibility && npm run check:metadata && npm run test:metadata-ux && npm run lint && npm run check-links",
    "lint": "markdownlint docs/**/*.md",
    "check-links": "markdown-link-check -c .markdown-link-check.json docs/**/*.md",
    "deploy": "gh-pages -d docs/_site",
    "check:metadata": "node scripts/check-metadata-consistency.js",
    "check:metadata:built": "node scripts/check-metadata-consistency.js --built-site docs/_site",
    "test:metadata-ux": "node scripts/test-metadata-ux-contract.js",
    "check:external-links": "node scripts/check-external-links.js --json .codex-local/tmp/external-link-report.json --markdown .codex-local/tmp/external-link-summary.md",
    "test:external-links": "node scripts/check-external-links.js --self-test",
    "test:content-sync": "node scripts/sync-canonical-content.js --self-test",
    "sync:content": "node scripts/sync-canonical-content.js --write",
    "check:content-drift": "node scripts/sync-canonical-content.js --check",
    "test:accessibility": "node scripts/check-accessible-content-blocks.js --self-test",
    "check:accessibility": "node scripts/check-accessible-content-blocks.js",
    "check:accessibility:built": "node scripts/check-accessible-content-blocks.js --built-site docs/_site",
    "check:accessibility:browser": "node scripts/check-accessible-content-browser.js --site docs/_site"
  },
  "keywords": [
    "book",
    "documentation",
    "ja"
  ],
  "author": "ITDO Inc.（株式会社アイティードゥ）",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.49.1",
    "markdown-link-check": "^3.14.2",
    "gh-pages": "^6.3.0"
  },
  "overrides": {
    "xmlbuilder2": {
      "js-yaml": "5.2.2"
    },
    "brace-expansion": "5.0.9",
    "ip-address": "10.5.0",
    "undici": "7.29.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itdojp/IT-engineer-communication-book.git"
  },
  "bugs": {
    "url": "https://github.com/itdojp/IT-engineer-communication-book/issues"
  },
  "homepage": "https://itdojp.github.io/IT-engineer-communication-book/"
}
