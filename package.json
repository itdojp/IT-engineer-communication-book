{
  "name": "it-engineer-communication-book",
  "version": "1.0.0",
  "description": "システム思考とデータ駆動で身につける対人スキルとメンタル管理",
  "main": "index.md",
  "scripts": {
    "start": "cd docs && bundle exec jekyll serve --livereload",
    "build": "cd docs && bundle exec jekyll build",
    "test": "npm run check:metadata && npm run lint && npm run check-links",
    "lint": "markdownlint docs/**/*.md",
    "check-links": "markdown-link-check -c .markdown-link-check.json docs/**/*.md",
    "deploy": "gh-pages -d docs/_site",
    "check:metadata": "node scripts/check-metadata-consistency.js",
    "sync:pilot": "node scripts/sync-pilot.js --write",
    "check:pilot-drift": "node scripts/sync-pilot.js --check"
  },
  "keywords": [
    "book",
    "documentation",
    "ja"
  ],
  "author": "ITDO Inc.（株式会社アイティードゥ）",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.49.0",
    "markdown-link-check": "^3.14.2",
    "gh-pages": "^6.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itdojp/IT-engineer-communication-book.git"
  },
  "bugs": {
    "url": "https://github.com/itdojp/IT-engineer-communication-book/issues"
  },
  "homepage": "https://itdojp.github.io/IT-engineer-communication-book/"
}
